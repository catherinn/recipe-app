# Production environment variables for Vite build
# IMPORTANT: Set VITE_GOOGLE_CLIENT_ID in Railway's environment variables (shared between build and runtime)

# API is served from the same origin in production (empty string = relative URLs)
VITE_API_URL=

# Google OAuth Client ID - MUST be set in Railway environment variables for the build to work
# Railway > Service Settings > Variables > Add Variable: VITE_GOOGLE_CLIENT_ID=your_actual_client_id
